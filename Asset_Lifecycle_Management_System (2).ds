		schedule
		{
			warranty_expiry_alert as "Warranty Expiry Alert"
			{
				type =  schedule
				form = asset_registry
					status = inactive
				start = warranty_end_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the warranty end date from the current input record
										warrantyEndDate = input.warranty_end_date;
										// Check if warranty end date is present and not null
										if(!warrantyEndDate.isNull())
										{
											// Calculate the date 30 days before warranty end date
											thirtyDaysBefore = warrantyEndDate.addDay(-30);
											// Get today's date
											currentDate = today;
											// Check if today is within 30 days of warranty end date
											if(currentDate >= thirtyDaysBefore && currentDate <= warrantyEndDate)
											{
												// Fetch the asset record to get vendor information
												// First, we need to find the vendor associated with this asset
												// Assuming there's a vendor field or we need to search vendor_directory
												// Get asset details
												assetName = input.asset_id;
												modelNumber = input.model_number;
												input.manufacturer = input.manufacturer;
												// Search for vendor in vendor_directory - assuming manufacturer matches vendor_name
												// or there's a vendor lookup field in asset_registry
												// Since no direct vendor lookup exists in asset_registry, we search by manufacturer
												vendorRecords = vendor_directory[vendor_name == input.manufacturer];
												// Check if vendor record exists
												if(vendorRecords.count() > 0)
												{
													// Get the first vendor record
													vendorRecord = vendorRecords;
													vendorEmail = vendorRecord.vendor_email;
													vendorName = vendorRecord.vendor_name;
													// Check if vendor email is present
													if(!vendorEmail.isNull() && !vendorEmail.isEmpty())
													{
														// Prepare email subject
														subject = "Warranty Expiry Alert: " + assetName;
														// Prepare email message
														message = "Dear " + vendorName + ",\n\n";
														message = message.concat("This is to inform you that the warranty for the following asset is approaching its end date:\n\n");
														message = message.concat("Asset Name: " + assetName + "\n");
														message = message.concat("Model Number: " + modelNumber + "\n");
														message = message.concat("Manufacturer: " + input.manufacturer + "\n");
														message = message.concat("Warranty End Date: " + warrantyEndDate.toString() + "\n\n");
														message = message.concat("Please take necessary actions to renew the warranty or arrange for maintenance.\n\n");
														message = message.concat("Best Regards,\nAsset Management Team");
														// Send email to vendor
														sendmail
														[
															from :zoho.loginuserid
															to :vendorEmail
															subject :subject
															message :message
															content type :Plain Text
														]
													}
												}
											}
										}
					)
					}
				}
			}
		}


