 application "Asset Lifecycle Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form asset_allocation
		{
			displayname = "Asset Allocation"
			success message = "Asset Allocation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Allocation_ID
			(
    			type = text
				displayname = "Allocation ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset
			(
				type = list	
				displayname = "Asset"
				values  = asset_registry.ID
    			displayformat = [asset_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			employee
			(
				type = list	
				displayname = "Employee"
				values  = employee_directory.ID
    			displayformat = [employee_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_email
			(
    			type = email
				displayname = "Employee email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			allocation_date
			(
    			type = date
				displayname = "Allocation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			expected_return_date
			(
    			type = date
				displayname = "Expected Return Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			actual_return_date
			(
    			type = date
				displayname = "Actual Return Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			allocation_purpose
			(
    			type = text
				displayname = "Allocation Purpose"
	 			row = 1
	 			column = 1   
				width = medium
			)
			handover_notes
			(
    			type = textarea
				displayname = "Handover Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Allocation Draft","Pending Approval","Approved","Rejected","Asset Handover","Active Allocation","Return Initiated","Asset Inspection","Allocation Closed","Dispute Resolution"}
			}
		}
		form asset_audit_history
		{
			displayname = "Asset Audit History"
			success message = "Asset Audit History Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			audit_id
			(
    			type = text
				displayname = "Audit ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset
			(
				type = list	
				displayname = "Asset"
				values  = asset_registry.ID
    			displayformat = [asset_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_performed
			(
    			type = text
				displayname = "Action Performed"
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_value
			(
    			type = text
				displayname = "Previous Value"
	 			row = 1
	 			column = 1   
				width = medium
			)
			new_value
			(
    			type = text
				displayname = "New Value"
	 			row = 1
	 			column = 1   
				width = medium
			)
			performed_by
			(
    			type = name
				displayname = "Performed By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			timestamp
			(
    			type = datetime
				displayname = "Timestamp"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			related_request_id
			(
    			type = text
				displayname = "Related Request ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
