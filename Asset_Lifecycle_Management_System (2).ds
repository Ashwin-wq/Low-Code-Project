				type = picklist
				displayname = "Sentiment"
				maxchar = 100
				private = true
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = SentimentAnalysis
									basefield = feedback
						)
			)
			analysis_status
			(
				type = picklist
				displayname = "Analysis Status"
				maxchar = 100
				values = {"Pending","Completed","Failed"}
